{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parkoreen Object Stamp",
  "description": "Portable, data-only collection of configured map objects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "name", "objects"],
  "properties": {
    "format": { "const": "parkoreen-object-stamp" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S" },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["x", "y", "width", "height"],
        "properties": {
          "x": { "type": "number", "minimum": -10000000, "maximum": 10000000 },
          "y": { "type": "number", "minimum": -10000000, "maximum": 10000000 },
          "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
          "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
          "collisionShape": { "enum": ["box", "circle", "capsule", "slopeUpRight", "slopeUpLeft", "polygon"] },
          "spriteSheet": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/$defs/spriteSheet" }
            ]
          },
          "sendTo": { "$ref": "#/$defs/portalConnections" },
          "receiveFrom": { "$ref": "#/$defs/portalConnections" }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "spriteSheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "frameWidth", "frameHeight", "frameCount", "fps"],
      "properties": {
        "data": { "type": "string", "maxLength": 1500000, "pattern": "^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$" },
        "frameWidth": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "frameHeight": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "frameCount": { "type": "integer", "minimum": 1, "maximum": 256 },
        "fps": { "type": "number", "minimum": 1, "maximum": 30 }
      }
    },
    "portalConnections": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "oneOf": [
          { "type": "string", "maxLength": 80 },
          {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string", "maxLength": 80 },
              "enabled": { "type": "boolean" }
            }
          }
        ]
      }
    }
  }
}
