{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parkoreen.com/schemas/plugin-package-v1.json",
  "title": "Parkoreen Plugin Transfer Package Metadata v1",
  "type": "object",
  "required": ["$schema", "formatVersion", "plugin", "files"],
  "properties": {
    "$schema": { "const": "https://parkoreen.com/schemas/plugin-package-v1.json" },
    "formatVersion": { "const": 1 },
    "plugin": {
      "type": "object",
      "required": ["id", "version", "apiVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "apiVersion": { "const": 1 }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 255,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*:)[A-Za-z0-9._/-]+$"
          },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 67108864 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
